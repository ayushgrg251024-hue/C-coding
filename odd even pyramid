#include <stdio.h>

int main() {
    int i, j, num;

    for (i = 1; i <= 5; i++) {
        // Decide starting number for each row
        if (i % 2 == 1)
            num = 1;   // odd rows start with 1
        else
            num = 2;   // even rows start with 2

        for (j = 1; j <= i; j++) {
            printf("%d ", num);
            num += 2;  // next odd/even number
        }

        printf("\n");
    }

    return 0;
}
